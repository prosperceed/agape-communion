PGLITE_DATA_DIR=".local-postgres"

# Auth.js Configuration
AUTH_SECRET="agape-communion-church-super-secret-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Initial Super Admin Provisioning
INITIAL_SUPER_ADMIN_EMAIL="superadmin@agapecommunion.org.ng"
INITIAL_SUPER_ADMIN_PASSWORD="AgapeSuperAdmin!2026"
